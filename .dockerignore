# Allow-list: the image build only needs the workspace manifests, the lockfile and apps/api.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!.pnpmfile.cjs
!tsconfig.base.json
!apps/*/package.json
!packages/*/package.json
!apps/api/
# Workspace packages the API imports (built in the image).
!packages/engine-client/
!packages/tax-legacy/
!packages/shared-types/

**/node_modules
**/dist
**/.turbo
**/coverage
**/.env
**/.env.*
apps/api/tests
apps/api/Dockerfile
