# Copy to .env for local use. DATABASE_URL and BETTER_AUTH_* are required; defaults for the rest
# are in src/config.ts.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Set by the deploy pipeline (git tag or commit); shown by /health and the OpenAPI document.
APP_VERSION=dev
# Application role: a login user that is a member of trs_app (created by the migrations), never
# the owner or a superuser, so row-level security applies. Example for a local database:
DATABASE_URL=postgres://trs_api@localhost:5432/trs
# Owner role, used only by `pnpm --filter @trs/api db:migrate`; never given to the running API.
# DATABASE_MIGRATION_URL=postgres://trs_owner@localhost:5432/trs
# Auth (better-auth). The secret signs session cookies: at least 32 random characters, different in
# every environment, e.g. `openssl rand -hex 32`. Never commit a real one.
BETTER_AUTH_SECRET=
# Public URL of this API; auth routes live under /api/auth.
BETTER_AUTH_URL=http://localhost:3000
# Public URL of the web app: trusted origin for auth requests and base of e-mail links.
# WEB_URL=http://localhost:3001
# More browser origins for CORS and the auth origin check, comma-separated: exact origins and https
# wildcard patterns whose * starts the host (e.g. PR previews https://*-trs-web.example.workers.dev).
# CORS_EXTRA_ORIGINS=
# Proxy hops trusted for the client address (rate limits): 0 locally, 1 behind Fly.io's proxy.
# TRUST_PROXY_HOPS=0
# Official engines (private network); see engines/README.md and deploy/README.md.
# ENGINE_REGIME_REGULAR_URL=http://localhost:8080
# ENGINE_SIMPLES_NACIONAL_URL=http://localhost:8082
# ENGINE_TIMEOUT_MS=30000
# REFERENCE_CACHE_TTL_SECONDS=21600
