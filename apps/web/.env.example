# Copy to .env for local use (Nuxt reads it in `nuxt dev`); in production set the variables in the
# host. Never commit a real .env.
# Public URL of the API (apps/api, BETTER_AUTH_URL there). Auth calls go to <url>/api/auth/*.
NUXT_PUBLIC_API_URL=http://localhost:3000
# Port of the web app; the API's WEB_URL must point here (trusted origin and e-mail links).
PORT=3001
